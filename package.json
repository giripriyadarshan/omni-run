{
  "name": "omni-run",
  "version": "0.1.0",
  "description": "Privacy-first, client-side WebAssembly code execution browser extension.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pyodide": "^314.0.3",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^22.13.0",
    "@types/webextension-polyfill": "^0.12.1",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "wxt": "^0.19.16"
  }
}
